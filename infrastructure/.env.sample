# Required AWS credentials
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_REGION="eu-central-1"  # or your preferred region

# Optional - only if you want to override the defaults
TF_VAR_domain_name="your_domain.com"
TF_VAR_subdomain="your_subdomain"
TF_VAR_certificate_arn="your_certificate_arn"